{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./*.css": "./dist/*.css",
    "./*.svg": "./dist/*.svg",
    "./*.webp": "./dist/*.webp",
    "./*.png": "./dist/*.png",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    },
    "./theme.css": "./theme.css",
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rslib build",
    "check": "oxfmt --check && oxlint",
    "dev": "rslib build --watch --no-clean",
    "dev:setup": "rslib build",
    "format": "oxfmt && (oxlint --fix || true)",
    "lint": "oxlint --deny-warnings",
    "update-translations": "lingui extract --clean && lingui compile --typescript"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "cmdk": "1.1.1",
    "react-dropzone": "15.0.0",
    "react-resizable-panels": "4.11.2",
    "recharts": "3.8.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@repo/build": "*",
    "@repo/config": "*"
  }
}
