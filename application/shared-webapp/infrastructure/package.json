{
  "name": "@repo/infrastructure",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rslib build",
    "check": "oxfmt --check && oxlint",
    "dev": "rslib build --watch --no-clean",
    "dev:setup": "rslib build",
    "format": "oxfmt && (oxlint --fix || true)",
    "lint": "oxlint --deny-warnings"
  },
  "devDependencies": {
    "@repo/build": "*",
    "@repo/config": "*",
    "@repo/ui": "*",
    "@repo/utils": "*"
  }
}
